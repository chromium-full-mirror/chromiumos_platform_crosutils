# We renamed the symlink.
for old_link in /home/*/trunk; do
  new_link="${old_link%/*}/chromiumos"
  if [[ -L "${old_link}" && ! -L "${new_link}" ]]; then
    ln -s /mnt/host/source "${new_link}"
  fi
done
